# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=financy_dev
DATABASE_USER=financy_user
DATABASE_PASSWORD=financy_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
# Optional. Shared with Telegram so the webhook endpoint can reject forged
# updates. Defaults to a value derived from the bot token; only set this to
# use your own (allowed characters: A-Z, a-z, 0-9, _, -).
TELEGRAM_WEBHOOK_SECRET=

# Transactional email (optional).
# Without RESEND_API_KEY the app still works: invitations are created and the
# inviter is given a link to share instead of an email being delivered.
# EMAIL_FROM must use a domain verified with the provider.
RESEND_API_KEY=
EMAIL_FROM=Financy <onboarding@resend.dev>

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Receipt OCR vision models (OpenRouter), tried in order until one succeeds.
# Defaults are free and vision-capable. Override with paid models
# (e.g. openai/gpt-4o, anthropic/claude-3.5-sonnet) for better accuracy.
VISION_MODELS=meta-llama/llama-3.2-11b-vision-instruct:free,qwen/qwen2.5-vl-72b-instruct:free,google/gemini-2.0-flash-exp:free

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100