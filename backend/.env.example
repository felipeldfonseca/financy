# Application
NODE_ENV=development
PORT=3000
# The canonical frontend address: links in invitation emails and bot messages
# are built from it, and it is allowed as a browser (CORS) origin.
FRONTEND_URL=http://localhost:3001
# Optional. Extra browser origins to allow besides FRONTEND_URL, comma-
# separated — e.g. the legacy .vercel.app address after moving to a custom
# domain, so links in already-delivered emails keep working.
EXTRA_CORS_ORIGINS=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=financy_dev
DATABASE_USER=financy_user
DATABASE_PASSWORD=financy_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
# Optional. Shared with Telegram so the webhook endpoint can reject forged
# updates. Defaults to a value derived from the bot token; only set this to
# use your own (allowed characters: A-Z, a-z, 0-9, _, -).
TELEGRAM_WEBHOOK_SECRET=

# Transactional email (optional).
# Without RESEND_API_KEY the app still works: invitations are created and the
# inviter is given a link to share instead of an email being delivered.
# EMAIL_FROM must use a domain verified with the provider.
RESEND_API_KEY=
EMAIL_FROM=Financy <onboarding@resend.dev>

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Receipt OCR vision models (OpenRouter), tried in order until one succeeds.
# Defaults: gemini-2.5-flash (top OCR accuracy, reads PDFs natively, ~$0.001/
# receipt) then qwen3-vl-235b (SOTA open-model OCR, cheaper) as a fallback.
# Cheaper alternatives: google/gemini-2.5-flash-lite, qwen/qwen3-vl-32b-instruct.
VISION_MODELS=google/gemini-2.5-flash,qwen/qwen3-vl-235b-a22b-instruct

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100