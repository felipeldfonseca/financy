REACT_APP_API_URL=http://localhost:3000/api/v1
REACT_APP_APP_NAME=Financy
REACT_APP_VERSION=$npm_package_version

# Feature flags
REACT_APP_ENABLE_TELEGRAM=true
# Telegram bot username the web app deep-links to (must match the bot behind TELEGRAM_BOT_TOKEN)
REACT_APP_TELEGRAM_BOT_USERNAME=Financy_Official_Bot
REACT_APP_ENABLE_OCR=false
REACT_APP_ENABLE_ANALYTICS=true

# External services
REACT_APP_SENTRY_DSN=
REACT_APP_GOOGLE_ANALYTICS_ID=